# Required for SiteRemade app/auth/database
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Production URL
PUBLIC_BASE_URL=https://app.siteremade.com
NODE_ENV=production

# Unified-login pass: the SiteRemade generator's own origin (a separate
# codebase/deployment), used only by GET /handoff/website-builder to build
# the return redirect and to reject any other destination. Defaults to
# https://siteremade.com when unset.
WEBSITE_BUILDER_URL=https://siteremade.com

# Existing integrations
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GOOGLE_PLACES_API_KEY=
RESEND_API_KEY=
RESEND_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Stripe — leave blank until Stripe setup begins
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SITEREMADE_MONTHLY_PRICE_CENTS=3900

# Future ads integrations — ads remain disabled in current server
GOOGLE_ADS_DEVELOPER_TOKEN=
META_ACCESS_TOKEN=

# Only needed if intentionally running npm run bootstrap-owner
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=
OWNER_WORKSPACE=
